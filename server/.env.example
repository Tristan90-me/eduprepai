# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=your_mongodb_connection_string

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key

# Admin
# Invite code required by POST /api/auth/admin-register — leave blank to disable admin self-registration entirely
ADMIN_SIGNUP_CODE=000-000
# Optional: if both are set, this admin account is auto-created on server startup if it doesn't already exist
ADMIN_EMAIL=
ADMIN_PASSWORD=
